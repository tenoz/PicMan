{
  "name": "图片侠-picman-v1",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/performance/**'",
    "typecheck": "tsc --noEmit",
    "test:perf": "vitest run --config vitest.config.ts && vitest bench --config vitest.config.ts",
    "test:bench": "vitest bench --config vitest.config.ts",
    "tauri:build": "tauri build",
    "bundle": "bash scripts/build-dmg.sh arm",
    "bundle:x64": "bash scripts/build-dmg.sh intel",
    "bundle:all": "bash scripts/build-dmg.sh both",
    "bundle:open": "open \"releases/PicMan_$(node -p 'require(\"./package.json\").version')_aarch64.dmg\"",
    "bundle:open:x64": "open \"releases/PicMan_$(node -p 'require(\"./package.json\").version')_x64.dmg\"",
    "version:sync": "node scripts/sync-version.mjs",
    "version:patch": "npm version patch && npm run version:sync",
    "version:minor": "npm version minor && npm run version:sync",
    "version:major": "npm version major && npm run version:sync"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "piexifjs": "1.0.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.4.0",
    "react-virtuoso": "^4.12.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "canvas": "^3.2.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
